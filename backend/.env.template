# Environment Configuration
NODE_ENV="development" # Options: 'development', 'production'
PORT="8080"            # The port your server will listen on
HOST="localhost"       # Hostname for the server

# CORS Settings
CORS_ORIGIN="http://localhost:8080" # Allowed CORS origin, adjust as necessary

# Rate Limiting
COMMON_RATE_LIMIT_WINDOW_MS="1000"  # Window size for rate limiting (ms)
COMMON_RATE_LIMIT_MAX_REQUESTS="20" # Max number of requests per window per IP

# PostgreSQL
# Local example for PostgreSQL 12:
DATABASE_HOST="127.0.0.1"
DATABASE_PORT="5432"
DATABASE_NAME="portfolio_db"
DATABASE_USER="postgres"
DATABASE_PASSWORD="postgres"
DATABASE_ADMIN_DB="postgres"

# Render example: set DATABASE_URL from Render and flip SSL on
# DATABASE_URL="postgres://..."
DATABASE_SSL="false"

# App startup behavior
DATABASE_INIT_ON_STARTUP="true"
DATABASE_SEED_ON_STARTUP="false"
